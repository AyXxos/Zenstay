# Configuration ZenStay
# Copiez ce fichier en .env et remplissez avec vos propres clés

# Port du serveur
PORT=3000

# Supabase (optionnel - pour la base de données et authentification)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe (pour les paiements)
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook n8n (pour les réservations - création + paiement)
WEBHOOK_URL=https://n8n.fatonfaton.fr/webhook/498996d1-1181-4c7f-aaa4-0c2dfcba4276/webhook

# Webhook n8n (pour l'envoi de facture PDF par email)
WEBHOOK_INVOICE_URL=https://n8n.fatonfaton.fr/webhook/498996d1-1181-4c7f-aaa4-0c2dfcba4276/webhook

# Note: Le webhook newsletter est codé en dur dans le frontend (app.js)
